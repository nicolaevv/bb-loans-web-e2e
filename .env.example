# Copy to .env and fill in. Never commit .env itself.

# UI Credentials
UI_USERNAME=
UI_PASSWORD=

# BNPL UI Credentials
BNPL_UI_USERNAME=
BNPL_UI_PASSWORD=

# API Credentials
API_CLIENT_ID=
API_CLIENT_SECRET=
API_TOKEN_URL=

# URLs
# BASE_URL is what Playwright resolves relative page.goto() paths against;
# playwright.config.ts falls back to this same value when it is not set.
BASE_URL=https://business.maib.test/loans
LOAN_ORIGINATION_API_URL=https://loan-origination-service.tstback.maib.md
SHELL_BFF_URL=https://bb-shell-bff.maib.test


# Test companies, one per product flow
TRANCHE_COMPANY_ID=
LOAN_COMPANY_ID=
ORDYNARY_GUARANTY_COMPANY_ID=
LINE_GUARANTY_COMPANY_ID=
